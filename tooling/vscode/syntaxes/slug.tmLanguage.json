{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SLUG",
  "scopeName": "source.slug",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#extended-identifiers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.slug",
          "match": "##!?[^\\r\\n]*"
        },
        {
          "name": "comment.block.slug",
          "begin": "#\\*!?",
          "end": "\\*#",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.slug",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.slug",
              "match": "\\\\(?:[nrt0\\\\'\"{}])"
            },
            {
              "name": "meta.interpolation.slug",
              "begin": "(?<!\\\\)\\{",
              "end": "(?<!\\\\)\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "keyword.control.import.slug",
          "match": ">(?=')"
        },
        {
          "name": "keyword.control.namespace.slug",
          "match": "<[ \\t]*:[ \\t]*(?:\\.|[A-Za-z][ \\t]*[A-Za-z]|_[ \\t]*[A-Za-z0-9](?:[ \\t]*[A-Za-z0-9])*[ \\t]*_)"
        },
        {
          "name": "support.type.module-uri.slug",
          "match": "@(?:std|dep)/[A-Za-z0-9_./-]+"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.slug",
          "match": "#[ \\t]*\\??[ \\t]*[A-Z][ \\t]*[A-Z](?![A-Za-z0-9_])"
        },
        {
          "name": "support.class.slug",
          "match": "(?<![A-Za-z0-9_])[A-Z][ \\t]*[A-Z](?![A-Za-z0-9_])"
        }
      ]
    },
    "extended-identifiers": {
      "patterns": [
        {
          "name": "variable.other.slug",
          "match": "_[A-Za-z0-9]+_"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.slug",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.slug",
          "match": "(?<![A-Za-z0-9_])[0-9]+\\$?(?![A-Za-z0-9_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.slug",
          "match": "(?<![A-Za-z0-9_])(?:i[ \\t]*f|e[ \\t]*i|e[ \\t]*e|w[ \\t]*l|f[ \\t]*l|b[ \\t]*l|c[ \\t]*l|r[ \\t]*v|t[ \\t]*r|c[ \\t]*a|f[ \\t]*n|e[ \\t]*r)(?![A-Za-z0-9_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.slug",
          "match": "(?<![A-Za-z0-9_])(?:c[ \\t]*o|c[ \\t]*i|t[ \\t]*y|c[ \\t]*v|i[ \\t]*n|i[ \\t]*v|l[ \\t]*n|s[ \\t]*l|b[ \\t]*y)(?![A-Za-z0-9_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.null.slug",
          "match": "(?<![A-Za-z0-9_])n[ \\t]*n(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.default.slug",
          "match": "(?<![A-Za-z0-9_])x[ \\t]*x(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.slug",
          "match": "<[ \\t]*:[ \\t]*\\.|:[ \\t]*:[ \\t]*=|![ \\t]*=[ \\t]*=|=[ \\t]*=[ \\t]*=|<[ \\t]*:|:[ \\t]*=|=[ \\t]*=|![ \\t]*=|<[ \\t]*=|>[ \\t]*=|\\+\\+|--|\\^\\^|~-|~~|//|\\^|[+\\-*/%!?=<>]|`"
        }
      ]
    }
  }
}
