##! SLUG Stage 2 module-aware, ordered direct-C backend.
##! This intentionally reuses the proven Stage-1 AST subset while replacing the two
##! largest bootstrap compromises: flattened module symbols and host-C evaluation order.
>'../v1/vector_core.slg'
>'module_graph.slg'
>'c_support.slg'
>'@std/fs':FS

##! Resolve a source variable to a module-global C symbol after lexical locals fail.
~db m n {
    r := m['rg'];
    y := in[n, r];
    ?y == @b|0| { z := nn; rv z; }
    p := r[n];
    g := p['cg'];
    y = in[n, g];
    ?y == @b|0| { z := nn; rv z; }
    z := g[n];
    rv z;
}

##! Resolve a source callable to its provider's native C symbol.
~dc m n {
    r := m['rf'];
    y := in[n, r];
    ?y == @b|0| { z := nn; rv z; }
    p := r[n];
    f := p['cf'];
    y = in[n, f];
    ?y == @b|0| { z := nn; rv z; }
    z := f[n];
    rv z;
}

##! Emit one SlugValue temporary assignment and return the temporary name.
~dd s d x {
    t := cc[s];
    s['dt'][t] := 1;
    q := 'SlugValue ' t +;
    q = q ' = ' +;
    q = q x +;
    q = q ';' +;
    cb[s, d, q];
    q = 'sv_local_root_add(&_slug_roots, &' t +;
    q = q ');' +;
    cb[s, d, q];
    cb[s, d, 'sv_gc_safepoint();'];
    rv t;
}


##! Deterministic native names and class metadata for the compact object backend.
~df m c {a:=@s|m['id']|;z:='slug_m' a +;z=z '_cl_' +;z=z cq[c]+;rv z;}
~dg m c n {z:=df[m,c];z=z '_sf_' +;z=z cq[n]+;rv z;}
~dh m c {z:=df[m,c];z=z '_init'+;rv z;}
~di m c {z:=df[m,c];z=z '_ctor'+;rv z;}
~dj m c n z {q:=df[m,c];if ?z {q=q '_sm_' +;}ee {q=q '_im_' +;}q=q cq[n]+;rv q;}
~dk m c {z:=df[m,c];z=z '_dtor'+;rv z;}
~dl n {z:='slug_dispatch_' cq[n]+;rv z;}

##! Resolve one aliased user module to its canonical provider module object.
-~ev m u {a:=m['al'];h:=in[u,a];?h==@b|0|{er 'unknown user module alias during Stage-2 C generation';}z:=a[u];rv z;}

##! Resolve a class spelling to the module that owns its native symbols.
-~fa m c {a:=m['cl'];h:=in[c,a];?h{rv m;}r:=m['rc'];h=in[c,r];?h{z:=r[c];rv z;}z:=nn;rv z;}

##! Resolve inherited method ownership as both provider module and owner class.
-~fb m c n z {
    p:=fa[m,c];?p==nn{r:=nn;rv r;}x:=p['cl'][c];a:=x['b'];k:=vl[a];i:=0;
    wl?i<k{q:=vg[a,i];?q['k']=='function'{?q['n']==n{?q['z']==z{r:=['m':p,'c':c];rv r;}}}i=i1+;}
    h:=x['h'];?h!=nn{r:=fb[p,h,n,z];rv r;}r:=nn;rv r;
}

##! Resolve inherited static-field ownership as provider module plus owner class.
-~fc m c n {
    p:=fa[m,c];?p==nn{r:=nn;rv r;}x:=p['cl'][c];a:=x['b'];k:=vl[a];i:=0;
    wl?i<k{q:=vg[a,i];?q['k']=='set-member'{t:=q['t'];?t['z']{?q['d']{?t['n']==n{r:=['m':p,'c':c];rv r;}}}}i=i1+;}
    h:=x['h'];?h!=nn{r:=fc[p,h,n];rv r;}r:=nn;rv r;
}
~dm m c {p:=fa[m,c];?p==nn{z:=nn;rv z;}a:=p['cl'];z:=a[c];rv z;}
~dn m c n z {r:=fb[m,c,n,z];?r==nn{q:=nn;rv q;}q:=r['c'];rv q;}
~do m c n {r:=fc[m,c,n];?r==nn{q:=nn;rv q;}q:=r['c'];rv q;}
~dp m c n {r:=fc[m,c,n];?r==nn{er 'unknown static class field';}z:=dg[r['m'],r['c'],n];rv z;}
~dq s m e a d {
    q:='(SlugValue[])\{';n:=vl[a];i:=0;
    wl ?i<n {?i>0{q=q ', ' +;}v:=ct[s,m,e,vg[a,i],d];q=q v +;i=i1+;}
    q=q '\}' +;?n==0{q='NULL';}z:=['q':q,'n':n];rv z;
}

##! Emit one method call as a raw SlugResult expression.
~dr s m e x d {
    ?x['k']!='method'{z:=nn;rv z;}
    n:=x['n'];c:=x['c'];r:=x['r'];_su_:=x['u'];_st_:=x['z'];
    if ?_su_ {
        _cu_:=s['cn'];_se_:=s['se'];?_cu_==nn{er 'super method outside class';}?_se_==nn{er 'super method outside instance context';}
        _cx_:=dm[m,_cu_];_pa_:=_cx_['h'];?_pa_==nn{er 'super method without parent';}
        _ow_:=fb[m,_pa_,n,0];?_ow_==nn{er 'unknown super method';}
        _ar_:=dq[s,m,e,x['a'],d];z:=dj[_ow_['m'],_ow_['c'],n,0];z=z '(' +;z=z _se_ +;z=z ', ' +;z=z @s|_ar_['n']| +;z=z ', ' +;z=z _ar_['q'] +;z=z ')' +;rv z;
    }
    ?c!=nn{
        _ow_:=fb[m,c,n,1];?_ow_==nn{er 'unknown static class method';}
        _ar_:=dq[s,m,e,x['a'],d];z:=dj[_ow_['m'],_ow_['c'],n,1];z=z '(' +;z=z @s|_ar_['n']| +;z=z ', ' +;z=z _ar_['q'] +;z=z ')' +;rv z;
    }
    ?r!=nn{
        _re_:=ct[s,m,e,r,d];_ar_:=dq[s,m,e,x['a'],d];z:=dl[n];z=z '(sv_as_object(' +;z=z _re_ +;z=z '), ' +;z=z @s|_ar_['n']| +;z=z ', ' +;z=z _ar_['q'] +;z=z ')' +;rv z;
    }
    _cu_:=s['cn'];?_cu_==nn{er 'current method outside class';}
    if ?_st_ {
        _ow_:=fb[m,_cu_,n,1];?_ow_==nn{er 'unknown current static method';}
        _ar_:=dq[s,m,e,x['a'],d];z:=dj[_ow_['m'],_ow_['c'],n,1];z=z '(' +;z=z @s|_ar_['n']| +;z=z ', ' +;z=z _ar_['q'] +;z=z ')' +;rv z;
    }
    _se_:=s['se'];?_se_==nn{er 'instance method from static context';}
    _ar_:=dq[s,m,e,x['a'],d];z:=dl[n];z=z '(' +;z=z _se_ +;z=z ', ' +;z=z @s|_ar_['n']| +;z=z ', ' +;z=z _ar_['q'] +;z=z ')' +;rv z;
}

##! Emit one object/static member write and return the resulting SlugValue C name.
~ds s m e t x d w i z {
    n:=t['n'];c:=t['c'];a:=t['a'];_st_:=t['z'];
    ?c!=nn{v:=ct[s,m,e,x,d];g:=dp[m,c,n];q:=g ' = ' +;q=q v +;q=q ';' +;cb[s,d,q];rv g;}
    ?a!=nn{
        b:=ct[s,m,e,a,d];v:=ct[s,m,e,x,d];q:='sv_object_set(' b +;q=q ', ' +;q=q ck[n] +;q=q ', ' +;q=q v +;q=q ', ' +;
        if ?w {q=q 'true' +;}ee{q=q 'false' +;}q=q ', ' +;if ?i{q=q 'true' +;}ee{q=q 'false' +;}q=q ', ' +;if ?z{q=q 'true' +;}ee{q=q 'false' +;}q=q ')' +;r:=dd[s,d,q];rv r;
    }
    ?_st_{_cl_:=s['cn'];?_cl_==nn{er 'static field write outside class';}v:=ct[s,m,e,x,d];g:=dp[m,_cl_,n];q:=g ' = ' +;q=q v +;q=q ';' +;cb[s,d,q];rv g;}
    _se_:=s['se'];?_se_==nn{er 'instance field write outside instance context';}v:=ct[s,m,e,x,d];q:='sv_object_set(sv_object_value(' _se_ +;q=q '), ' +;q=q ck[n] +;q=q ', ' +;q=q v +;q=q ', ' +;
    if ?w {q=q 'true' +;}ee{q=q 'false' +;}q=q ', ' +;if ?i{q=q 'true' +;}ee{q=q 'false' +;}q=q ', ' +;if ?z{q=q 'true' +;}ee{q=q 'false' +;}q=q ')' +;r:=dd[s,d,q];rv r;
}

##! Attach native function/global symbol maps to every module and validate direct imports
##! against the builtin namespace. Own module definitions may intentionally shadow builtins.
~de s g {
    b := s['b'];
    a := g['mods'];
    n := vl[a];
    i := 0;
    wl ?i < n {
        m := vg[a, i];
        f := [:];
        v := [:];
        _cm_ := [:];
        p := m['ast'];
        _pn_ := vl[p];
        j := 0;
        wl ?j < _pn_ {
            x := vg[p, j];
            k := x['k'];
            ?k == 'function' {
                q := x['n'];
                z := cr[m, q];
                f[q] := z;
            }
            ?k == 'class' {
                q := x['n'];
                _ci_ := s['cid'];
                s['cid'] = _ci_ 1 +;
                x['id'] := _ci_;
                _cm_[q] := x;
            }
            y := 0;
            ?k == 'define' { y = 1; }
            ?y {
                q := x['n'];
                z := cs[m, q];
                v[q] := z;
            }
            _mu_ := 0; ?k == 'define-multi' { _mu_=1; }
            ?_mu_ {
                _ma_ := x['a']; _mn_ := vl[_ma_]; _mi_ := 0;
                wl ?_mi_ < _mn_ { q:=vg[_ma_,_mi_]; z:=cs[m,q]; v[q]:=z; _mi_=_mi_1+; }
            }
            j = j 1 +;
        }
        m['cf'] := f;
        m['cg'] := v;
        m['cl'] := _cm_;
        i = i 1 +;
    }

    ##! A direct import cannot inject a builtin spelling into the importing scope.
    i = 0;
    wl ?i < n {
        m := vg[a, i];
        d := m['direct'];
        _dn_ := vl[d];
        _di_ := 0;
        wl ?_di_ < _dn_ {
            c := vg[d, _di_];
            p := c['aud'];
            _pn_ := vl[p];
            j := 0;
            wl ?j < _pn_ {
                x := vg[p, j];
                k := x['k'];
                y := 0;
                ?k == 'function' { _pr_:=x['p']; ?!_pr_ { y = 1; } }
                ?k == 'export' { y = 1; }
                ?y {
                    q := x['n'];
                    _has_ := in[q, b];
                    ?_has_ { er 'direct import collision with Stage-2 builtin'; }
                }
                j = j 1 +;
            }
            _di_ = _di_ 1 +;
        }
        i = i 1 +;
    }
    rv;
}


##! K7B: container-only expression emission. Deep list/map nesting recurses here
##! instead of through the full general-purpose ct frame.
~cw s m e x d {
    k:=x['k'];
    ?k=='list'{
        a:=x['a'];n:=vl[a];?n==0{rv 'sv_list_empty(false)';}
        q:='(SlugValue[])\{';i:=0;
        wl?i<n{
            ?i>0{q=q ', ' +;}y:=vg[a,i];_yk_:=y['k'];_cn_:=0;v:='';?_yk_=='list'{_cn_=1;}?_yk_=='map'{_cn_=1;}
            if ?_cn_{v=cw[s,m,e,y,d];}ee{v=ct[s,m,e,y,d];}
            q=q v +;i=i1+;
        }
        q=q '\}' +;q='sv_list_from(' q +;q=q ', ' +;q=q @s|n| +;q=q ', false)' +;z:=dd[s,d,q];rv z;
    }
    ?k=='map'{
        a:=x['a'];n:=vl[a];?n==0{rv 'sv_map_empty(false)';}
        q:='(SlugValue[])\{';i:=0;
        wl?i<n{
            ?i>0{q=q ', ' +;}y:=vg[a,i];_kx_:=y['a'];_vx_:=y['b'];_kt_:=_kx_['k'];_vt_:=_vx_['k'];_kn_:=0;_vn_:=0;_kv_:='';_vv_:='';
            ?_kt_=='list'{_kn_=1;}?_kt_=='map'{_kn_=1;}?_vt_=='list'{_vn_=1;}?_vt_=='map'{_vn_=1;}
            if ?_kn_{_kv_=cw[s,m,e,_kx_,d];}ee{_kv_=ct[s,m,e,_kx_,d];}
            if ?_vn_{_vv_=cw[s,m,e,_vx_,d];}ee{_vv_=ct[s,m,e,_vx_,d];}
            q=q _kv_ +;q=q ', ' +;q=q _vv_ +;i=i1+;
        }
        q=q '\}' +;q='sv_map_from(' q +;q=q ', ' +;q=q @s|n| +;q=q ', false)' +;z:=dd[s,d,q];rv z;
    }
    er 'container emitter received non-container expression';
}

##! Ordered expression lowering. Recursive calls emit their prelude immediately, so every
##! observable subexpression runs left-to-right before the enclosing operation is emitted.
~ct s m e x d {
    q := '';
    _c0_ := '';
    k := x['k'];
    ?k == 'list' { z := cw[s, m, e, x, d]; rv z; }
    ?k == 'map' { z := cw[s, m, e, x, d]; rv z; }
    ?k == 'default' {rv 'sv_default()';}

    ?k == 'lit' {
        t := x['t'];
        r := x['r'];
        ?t == 'null' { rv 'sv_null()'; }
        ?t == 'int' {
            n := ln[r];
            ?n > 0 {
                q = n 1 -;
                ?r[q] == '$' { r = r[:q]; }
            }
            _ul_ := 0; _rn_ := ln[r];
            ?_rn_ > 19 { _ul_ = 1; }
            ?_rn_ == 19 { ?r > '9223372036854775807' { _ul_ = 1; } }
            z := '';
            if ?_ul_ {
                z = 'sv_uint(UINT64_C(' r +;
                z = z '))' +;
            }
            ee {
                z = 'sv_int(INT64_C(' r +;
                z = z '))' +;
            }
            rv z;
        }
        ?t == 'float' {
            ?r[0] == '.' { r = '0' r +; }
            z := 'sv_float(' r +;
            z = z ')' +;
            rv z;
        }
        ?t == 'string' {
            q = cj[r];
            _sb_ := by[q];
            _sn_ := ln[_sb_];
            _st_ := @s|_sn_|;
            q = ck[q];
            z := 'sv_string_literal_n((const unsigned char*)' q +;
            z = z ', ' +;
            z = z _st_ +;
            z = z ')' +;
            rv z;
        }
        er 'unsupported Stage-2 literal kind';
    }

    ?k == 'assign-expr' {
        v:=ct[s,m,e,x['v'],d];
        _an_:=x['n'];
        _en_:=vl[e];_ei_:=_en_1-;_em_:=vg[e,_ei_];_ah_:=in[_an_,_em_];
        _ac_:=nn;
        if ?_ah_ { _ac_=_em_[_an_]; }
        ee { _ac_=db[m,_an_]; }
        if ?_ac_==nn {
            _ac_=ch[s,e,_an_];
            q:='SlugValue ' _ac_ +;q=q ' = '+;q=q v+;q=q ';'+;cb[s,d,q];
            q='sv_local_root_add(&_slug_roots, &' _ac_ +;q=q ');'+;cb[s,d,q];
        }
        ee { q=_ac_ ' = '+;q=q v+;q=q ';'+;cb[s,d,q]; }
        rv _ac_;
    }

    ?k == 'format' {
        a:=x['a'];n:=vl[a];
        _fa_:=dd[s,d,'sv_string_literal_n((const unsigned char*)"", 0)'];
        i:=0;
        wl ?i<n {
            y:=vg[a,i];
            _fc_:='';_fp_:='';
            if ?y['k']=='text' {
                q=cj[y['r']];
                _fb_:=by[q];
                _fn_:=ln[_fb_];
                _ft_:=@s|_fn_|;
                q=ck[q];
                _fc_='sv_string_literal_n((const unsigned char*)' q +;
                _fc_=_fc_ ', ' +;
                _fc_=_fc_ _ft_ +;
                _fc_=_fc_ ')' +;
                _fp_=dd[s,d,_fc_];
            }
            ee {
                _fv_:=ct[s,m,e,y['v'],d];
                _fc_='sv_cast_s(' _fv_ +;
                _fc_=_fc_ ')' +;
                _fp_=dd[s,d,_fc_];
            }
            _fc_='sv_add(' _fa_ +;
            _fc_=_fc_ ', ' +;
            _fc_=_fc_ _fp_ +;
            _fc_=_fc_ ')' +;
            _fa_=dd[s,d,_fc_];
            i=i1+;
        }
        rv _fa_;
    }

    ?k == 'var' {
        n := x['n'];
        z := cg[e, n];
        ?z != nn { rv z; }
        z = db[m, n];
        ?z == nn { er 'undefined binding during Stage-2 C generation'; }
        rv z;
    }

    ?k == 'bin' {
        a := ct[s, m, e, x['a'], d];
        b := ct[s, m, e, x['b'], d];
        o := x['o'];
        f := ['+': 'sv_add', '-': 'sv_sub', '*': 'sv_mul', '/': 'sv_div', '//': 'sv_idiv', '%': 'sv_mod', '^': 'sv_pow'];
        y := in[o, f];
        ?y == @b|0| { er 'unsupported Stage-2 binary operator'; }
        q = f[o] '(' +;
        q = q a +;
        q = q ', ' +;
        q = q b +;
        q = q ')' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'cmp' {
        a := ct[s, m, e, x['a'], d];
        b := ct[s, m, e, x['b'], d];
        o := x['o'];
        if ?o == '==' {
            q = 'sv_bool(sv_equal(' a +;
            q = q ', ' +;
            q = q b +;
            q = q '))' +;
        }
        ee {
            if ?o == '!=' {
                q = 'sv_bool(!sv_equal(' a +;
                q = q ', ' +;
                q = q b +;
                q = q '))' +;
            }
            ee {
                if ?o == '===' {
                    q = 'sv_bool(sv_identical(' a +;
                    q = q ', ' +;
                    q = q b +;
                    q = q '))' +;
                }
                ee {
                    if ?o == '!==' {
                        q = 'sv_bool(!sv_identical(' a +;
                        q = q ', ' +;
                        q = q b +;
                        q = q '))' +;
                    }
                    ee {
                        q = 'sv_bool(sv_compare(' a +;
                        q = q ', ' +;
                        q = q b +;
                        q = q ') ' +;
                        q = q o +;
                        q = q ' 0)' +;
                    }
                }
            }
        }
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'logic' {
        a := ct[s, m, e, x['a'], d];
        o := x['o'];
        ?o!='and'{?o!='or'{er 'unsupported Stage-2 logic operator';}}
        if ?o=='and' { q = 'sv_bool(false)'; }
        ee { q = 'sv_bool(true)'; }
        z := dd[s, d, q];
        if ?o=='and' { q = 'if (sv_truthy(' a +; }
        ee { q = 'if (!sv_truthy(' a +; }
        q = q ')) \{' +;
        cb[s, d, q];
        b := ct[s, m, e, x['b'], d 1 +];
        q = z ' = sv_bool(sv_truthy(' +;
        q = q b +;
        q = q '));' +;
        cb[s, d 1 +, q];
        cb[s, d, '\}'];
        rv z;
    }

    ?k == 'bool' {
        a := ct[s, m, e, x['v'], d];
        q = 'sv_bool(sv_truthy(' a +;
        q = q '))' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'not' {
        a := ct[s, m, e, x['v'], d];
        q = 'sv_bool(!sv_truthy(' a +;
        q = q '))' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'unary' {
        ?x['o'] != '-' { er 'unsupported Stage-2 unary operator'; }
        a := ct[s, m, e, x['v'], d];
        q = 'sv_neg(' a +;
        q = q ')' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'cast' {
        a := ct[s, m, e, x['v'], d];
        t := x['t'];
        if ?t == 'i' { q = 'sv_cast_i_width(' a +; q = q ', 64)' +; }
        ee {
            if ?t == 'b' { q = 'sv_cast_b(' a +; q = q ')' +; }
            ee {
                if ?t == 's' { q = 'sv_cast_s(' a +; q = q ')' +; }
                ee {
                    ?t != 'f' { er 'unsupported Stage-2 cast'; }
                    q = 'sv_cast_f(' a +;
                    q = q ')' +;
                }
            }
        }
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'list' {
        a := x['a'];
        n := vl[a];
        ?n == 0 { rv 'sv_list_empty(false)'; }
        q = '(SlugValue[])\{';
        i := 0;
        wl ?i < n {
            ?i > 0 { q = q ', ' +; }
            y := vg[a, i];
            v := ct[s, m, e, y, d];
            q = q v +;
            i = i 1 +;
        }
        q = q '\}' +;
        q = 'sv_list_from(' q +;
        q = q ', ' +;
        q = q @s|n| +;
        q = q ', false)' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'map' {
        a := x['a'];
        n := vl[a];
        ?n == 0 { rv 'sv_map_empty(false)'; }
        q = '(SlugValue[])\{';
        i := 0;
        wl ?i < n {
            ?i > 0 { q = q ', ' +; }
            y := vg[a, i];
            _kv_ := ct[s, m, e, y['a'], d];
            _vv_ := ct[s, m, e, y['b'], d];
            q = q _kv_ +;
            q = q ', ' +;
            q = q _vv_ +;
            i = i 1 +;
        }
        q = q '\}' +;
        q = 'sv_map_from(' q +;
        q = q ', ' +;
        q = q @s|n| +;
        q = q ', false)' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'index' {
        a := ct[s, m, e, x['a'], d];
        b := ct[s, m, e, x['b'], d];
        q = 'sv_index(' a +;
        q = q ', ' +;
        q = q b +;
        q = q ')' +;
        z := dd[s, d, q];
        rv z;
    }

    ?k == 'slice' {
        a := ct[s, m, e, x['a'], d];
        b := 'sv_null()';
