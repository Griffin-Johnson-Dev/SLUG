##! SLUG v1 ambiguity-aware ordinary-expression parser.
##! Compiled by the frozen Stage-2 backend; does not modify the v0.1.7.1 oracle.
>'vector_core.slg'
>'common.slg'
>'signatures.slg'

##! Two-lowercase token pair or ''.
~ea c p {
    t := c['t'];
    ?hd[t,p] != 'LOWER' { rv ''; }
    ?hd[t,p 1 +] != 'LOWER' { rv ''; }
    s := hb[t,p] hb[t,p 1 +] +;
    rv s;
}

##! Parse @type. Returns ['t':code,'p':end] or nn.
~eb c p {
    t := c['t'];
    ?hb[t,p] != '@' { z:=nn; rv z; }
    ?hd[t,p 1 +] != 'LOWER' { z:=nn; rv z; }
    b := hb[t,p 1 +];
    _ebhas_:=in[b,'iufsb']; ?!_ebhas_ { z:=nn; rv z; }
    s := p 2 +;
    i := s;
    w := '';
    wl ?hd[t,i] == 'DIGIT' {
        w = w hb[t,i] +;
        i = i 1 +;
    }
    _ok_ := 0;
    ?b == 'i' { ?in[w, ['8':1,'16':1,'32':1,'64':1]] { _ok_=1; } }
    ?b == 'u' { ?in[w, ['8':1,'16':1,'32':1,'64':1]] { _ok_=1; } }
    ?b == 'f' { ?w == '64' { _ok_=1; } }
    ?_ok_ {
        q := b w +;
        rv ['t':q,'p':i];
    }
    rv ['t':b,'p':s];
}

##! Lexical assignment target list with optional contracts.
##! Returns AST target vector a, type vector y, assignment-op position p.
~ec c p {
    t := c['t'];
    a := vn[];
    y := vn[];
    i := p;
    z := 1; _good_ := 0;
    wl ?z {
        k := hd[t,i];
        q := hb[t,i];
        _good_ = 0;
        ?k == 'LOWER' { _good_=1; }
        ?k == 'EXT' { _good_=1; }
        ?!_good_ { bl }
        ?k == 'LOWER' { x := hn['var',q]; vp[a,x]; }
        ee { x := hn['ext',q]; vp[a,x]; }
        i = i 1 +;
        _tc_ := nn;
        ?hb[t,i] == '@' {
            r := eb[c,i];
            ?r == nn { z:=nn; rv z; }
            _tc_ = r['t'];
            i = r['p'];
        }
        vp[y,_tc_];
    }
    ?vl[a] <= 0 { z:=nn; rv z; }
    _op_ := hb[t,i];
    _good_ = 0;
    ?_op_ == '=' { _good_=1; }
    ?_op_ == ':=' { _good_=1; }
    ?_op_ == '::=' { _good_=1; }
    ?!_good_ { z:=nn; rv z; }
    rv ['a':a,'y':y,'p':i];
}

##! Scan a full decimal digit run terminated by $. Returns record or nn.
~ed c p {
    t := c['t'];
    i := p;
    r := '';
    n := 0;
    z := 1; _good_ := 0;
    wl ?z {
        k := hd[t,i]; q := hb[t,i]; _good_ = 0;
        ?k == 'DIGIT' { _good_=1; }
        ?!_good_ { bl }
        r = r q +; n = n 1 +; i = i 1 +;
    }
    ?n > 0 { ?hb[t,i] == '$' { r = r '$' +; rv ['r':r,'p':i 1 +]; } }
    z:=nn; rv z;
}

##! Iterative fast path for arbitrarily deep singleton list spines.
##! It consumes consecutive [ / @[ openers, parses the first non-list inner
##! expression once, then wraps matching ] delimiters outward without recursive
##! list-parser descent.  If the shape is not a pure singleton spine it returns
##! no candidates and the ordinary ambiguity-aware parser remains authoritative.
~en c p {
    t:=c['t']; _flags_:=vn[]; i:=p; z:=1;
    wl ?z {
        x:=hb[t,i];
        ?x=='[' { vp[_flags_,0]; i=i1+; cl }
        ?x=='@' { ?hb[t,i1+]=='[' { vp[_flags_,1]; i=i2+; cl } }
        bl
    }
    n:=vl[_flags_]; _out_:=vn[];
    ?n<2 { rv _out_; }
    _ch_:=ez[c,i]; m:=vl[_ch_]; j:=0;
    wl ?j<m {
        q:=vg[_ch_,j]; e:=q['p']; v:=q['e']; k:=n1-; _ok_:=1;
        wl ?k>=0 {
            ?hb[t,e]!=']' { _ok_=0; bl }
            a:=vn[]; vp[a,v]; _kind_:='list'; ?vg[_flags_,k] { _kind_='frozen-list'; }
            v=hy[_kind_,a]; e=e1+;
            ?k==0 { bl }
            k=k1-;
        }
        ?_ok_ { hl[_out_,v,e,q['s']]; }
        j=j1+;
    }
    rv ic[_out_];
}

##! Expression candidate memo entry point.
~ez c p {
    m := c['m'];
    q := @s|p|;
    ?in[q,m] { a:=m[q]; rv a; }
    _empty_ := vn[];
    m[q] := _empty_;
    a := en[c,p];
    ?vl[a]>0 { m[q]=a; rv a; }
    a = ef[c,p];
    a = ic[a];
    m[q] = a;
    rv a;
}

##! Return index of cheapest state in a vector, tie-breaking by token position.
~eg a {
    n := vl[a];
    ?n <= 0 { rv 0; }
    b := 0;
    x := vg[a,0];
    i := 1;
    wl ?i < n {
        y := vg[a,i];
        _take_ := 0;
        ?y['s'] < x['s'] { _take_=1; }
        ?y['s'] == x['s'] { ?y['p'] < x['p'] { _take_=1; } }
        ?_take_ { b=i; x=y; }
        i=i1+;
    }
    rv b;
}

##! Remove vector element i by moving the final element into its slot.
~eh a i {
    ##! Internal dual mode: vectors use the historical remove-at behavior; parser
    ##! contexts (identified by key 't') request lexical indexed-target candidates.
    ?in['t',a]{
        t:=a['t'];k:=hd[t,i];o:=vn[];_ok_:=0;?k=='LOWER'{_ok_=1;}?k=='EXT'{_ok_=1;}
        ?!_ok_{rv o;}?hb[t,i1+]!='['{rv o;}
        b:=nn;?k=='LOWER'{b=hn['var',hb[t,i]];}ee{b=hn['ext',hb[t,i]];}
        q:=ey[a,b,i1+,0];n:=vl[q];j:=0;
        wl?j<n{x:=vg[q,j];?x['e']['k']=='index'{vp[o,x];}j=j1+;}
        rv o;
    }
    n := vl[a];
    ?n <= 0 { z:=nn; rv z; }
    x := vg[a,i];
    _last_ := vo[a];
    ?i < n 1 - { vs[a,i,_last_]; }
    rv x;
}

##! RPN candidate search. Preference queue matches the frozen oracle's cheap-first rule.
##! Seed prefix lexical assignment candidates into output o.
~jk c p o {
    t := c['t'];
    r := ec[c,p];
    ?r == nn { rv; }
    x := hb[t,r['p']];
    z := 0; ?x == ':=' {z=1;} ?x == '::=' {z=1;}
    ?!z { rv; }
    a := ez[c,r['p']1+]; n := vl[a]; i := 0;
    wl ?i<n {
        q:=vg[a,i]; v:=r['a']; d:=vl[v]1-; d=d3*;
        y:=['k':'assign-expr','o':x,'a':v,'y':r['y'],'v':q['e']];
        hl[o,y,q['p'],q['s'] d +];
        i=i1+;
    }
    rv;
}

##! Stable state key for seen-set suppression.
~jl v p s {
    k:=@s|p|; k=k ':'+; k=k @s|s|+; k=k ':'+;
    n:=vl[v]; i:=0;
    wl ?i<n { k=k ib[vg[v,i]]+; k=k ';'+; i=i1+; }
    rv k;
}

##! Hard expression boundary at token p.
~jm c p {
    t:=c['t']; x:=hb[t,p]; k:=hd[t,p];
    ?x==';'{rv1;} ?x=='\}'{rv1;} ?x==']'{rv1;} ?x==','{rv1;} ?x==':'{rv1;} ?x==''{rv1;}
    ?k=='EOF'{rv1;} ?k=='COMMENT'{rv1;}
    rv0;
}

##! Expand one RPN operator state. Returns 1 when token is an operator/boundary form.
~jn c q a {
    t:=c['t']; p:=q['p']; v:=q['v']; s:=q['s']; n:=vl[v]; x:=hb[t,p];
    z:=0; ?in[x,['+':1,'-':1,'*':1,'/':1,'//':1,'%':1,'^':1]]{z=1;} ?!z{rv0;}
    ?n<=0{rv1;}
    ?x=='-' {
        y:=hb[t,p1+]; b:=0;
        ?y=='#'{b=1;} ?y=='~'{b=1;} ?y=='~~'{b=1;} ?y=='.'{b=1;}
        ?b{rv1;}
        w:=hi[v]; u:=vo[w]; u=['k':'unary','o':'-','v':u]; vp[w,u];
        vp[a,['p':p1+,'v':w,'s':s,'c':1]];
    }
    ?n>=2{
        w:=hi[v]; d:=vo[w]; b:=vo[w]; u:=hq[x,b,d]; vp[w,u];
        vp[a,['p':p1+,'v':w,'s':s,'c':1]];
    }
    rv1;
}

##! Expand atom continuations for one state.
~jo c q a {
    p:=q['p']; v:=q['v']; s:=q['s']; n:=vl[v];
    x:=iz[c,p]; m:=vl[x]; i:=0;
    wl ?i<m {
        d:=vg[x,i];
        w:=hi[v]; vp[w,d['e']]; z:=0; k:=d['e']['k'];
        ?n>0{?k=='assign-expr'{z=8;}}
        vp[a,['p':d['p'],'v':w,'s':s d['s'] + z +,'c':1]];
        i=i1+;
    }
    rv;
}

##! RPN candidate search. Preference queue matches the frozen oracle's cheap-first rule.
~ef c p {
    o:=vn[]; jk[c,p,o];
    a:=vn[]; v:=vn[]; vp[a,['p':p,'v':v,'s':0,'c':0]];
    m:=[:];
    wl ?vl[a]>0 {
        j:=eg[a]; q:=eh[a,j]; v=q['v']; n:=vl[v];
        k:=jl[v,q['p'],q['s']]; ?in[k,m]{cl} m[k]:=1;
        ?q['c']{?n==1{hl[o,vg[v,0],q['p'],q['s']];}}
        ?jm[c,q['p']]{cl}
        ?jn[c,q,a]{cl}
        jo[c,q,a];
    }
    rv o;
}

##! Consume exactly n inferred call arguments. Records: a=args, p=end, s=score.
~ej c p n {
    _out_ := vn[];
    _args_ := vn[];
    ek[c,p,n,_args_,0,_out_];
    rv _out_;
}
~ek c p n _args_ _score_ _out_ {
    ?n == 0 { vp[_out_,['a':_args_,'p':p,'s':_score_]]; rv; }
    _ch_ := ez[c,p];
    ##! xx is default sentinel in named-call context.
    _extra_ := 0; _na_:=nn;
    ?ea[c,p] == 'xx' { _extra_=1; }
    ?_extra_ {
        _na_ = hj[_args_,hm['default']];
        ek[c,p2+,n1-,_na_,_score_,_out_];
    }
    _cn_ := vl[_ch_]; i := 0;
    wl ?i < _cn_ {
        e := vg[_ch_,i];
        _pen_ := 0; _kk_ := e['e']['k'];
        ?_kk_ == 'assign-expr' {_pen_=18$;}
        ?_kk_ == 'call' {
            _nm_ := e['e']['n'];
            ?_nm_ == 'co' {_pen_=18$;} ?_nm_ == 'ci' {_pen_=18$;}
        }
        _na_ = hj[_args_,e['e']];
        ek[c,e['p'],n1-,_na_,_score_ e['s'] + _pen_ +,_out_];
        i=i1+;
    }
    rv;
}

##! Explicit [arg,...] pack.
~el c p _allow_ {
    _out_ := vn[];
    t := c['t'];
    ?hb[t,p] != '[' { rv _out_; }
    ?hb[t,p1+] == ']' {
        a:=vn[]; vp[_out_,['a':a,'p':p2+,'s':0]]; rv _out_;
    }
    a:=vn[];
    em[c,p1+,_allow_,a,0,_out_];
    rv _out_;
}
~em c p _allow_ _args_ _score_ _out_ {
    t:=c['t'];a:=nn;
    _choices_ := ez[c,p];
    ?_allow_ { ?ea[c,p] == 'xx' {
        d:=hm['default'];
        _np_:=p2+;
        ?hb[t,_np_] == ']' { a=hj[_args_,d]; vp[_out_,['a':a,'p':_np_1+,'s':_score_]]; }
        ?hb[t,_np_] == ',' { a=hj[_args_,d]; em[c,_np_1+,_allow_,a,_score_,_out_]; }
    } }
    n:=vl[_choices_]; i:=0;
    wl ?i<n {
        q:=vg[_choices_,i]; _np_:=q['p'];
        ?hb[t,_np_] == ']' { a=hj[_args_,q['e']]; vp[_out_,['a':a,'p':_np_1+,'s':_score_ q['s'] +]]; }
        ?hb[t,_np_] == ',' { a=hj[_args_,q['e']]; em[c,_np_1+,_allow_,a,_score_ q['s'] +,_out_]; }
        i=i1+;
    }
    rv;
}

##! Generate named-call candidates from an exact signature.
~eo c _name_ _sig_ p _forced_ {
    _out_:=vn[];
    _min_:=_sig_['a']; _max_:=_sig_['b'];
    n:=_max_;
    wl ?n >= _min_ {
        _cs_:=ej[c,p,n]; _cn_:=vl[_cs_]; i:=0;
        wl ?i<_cn_ {
            q:=vg[_cs_,i];
            _pen_:=n _min_ -; _pen_=_pen_3*;
            ?!_forced_ {_pen_=_pen_4+;}
            x:=hx[_name_,q['a']];
            hl[_out_,x,q['p'],q['s'] _pen_ +];
            i=i1+;
        }
        ?n==0{bl}
        n=n1-;
    }
    rv _out_;
}

##! List parser.
~ep c p _frozen_ {
    _out_:=vn[]; t:=c['t'];
    ?hb[t,p] != '[' {rv _out_;}
    ?hb[t,p1+] == ']' {
        a:=vn[]; k:='list'; ?_frozen_{k='frozen-list';}
        x:=hy[k,a]; hl[_out_,x,p2+,0]; rv _out_;
    }
    a:=vn[];
    eq[c,p1+,_frozen_,a,0,_out_];
    rv ic[_out_];
}
~eq c p _frozen_ _items_ _score_ _out_ {
    t:=c['t'];a:=nn;k:=''; _ch_:=ez[c,p]; n:=vl[_ch_]; i:=0;
    wl ?i<n {
        q:=vg[_ch_,i]; e:=q['p'];
        ?hb[t,e] == ']' {
            a=hj[_items_,q['e']]; k='list'; ?_frozen_{k='frozen-list';}
            x:=hy[k,a]; hl[_out_,x,e1+,_score_ q['s'] +];
        }
        ?hb[t,e] == ',' {
            a=hj[_items_,q['e']]; eq[c,e1+,_frozen_,a,_score_ q['s'] +,_out_];
        }
        i=i1+;
    }
    rv;
}

##! Map parser.
~es c p _frozen_ {
    _out_:=vn[]; t:=c['t'];
    ?hb[t,p] != '[' {rv _out_;}
    ?hb[t,p1+] == ':' { ?hb[t,p2+] == ']' {
        a:=vn[]; x:=hy['map',a]; x['f']:=_frozen_; hl[_out_,x,p3+,0]; rv _out_;
    } }
    a:=vn[];
    et[c,p1+,_frozen_,a,0,_out_];
    rv ic[_out_];
}
~et c p _frozen_ _entries_ _score_ _out_ {
    t:=c['t']; _keys_:=ez[c,p]; _kn_:=vl[_keys_]; i:=0;
    wl ?i<_kn_ {
        k:=vg[_keys_,i];
        ?hb[t,k['p']] == ':' {
            _vals_:=ez[c,k['p']1+]; _valn_:=vl[_vals_]; j:=0;
            wl ?j<_valn_ {
                v:=vg[_vals_,j]; e:=v['p']; _pair_:=hz[k['e'],v['e']]; a:=hj[_entries_,_pair_]; _sc_:=_score_ k['s'] + v['s'] +;
                ?hb[t,e] == ']' { x:=hy['map',a]; x['f']:=_frozen_; hl[_out_,x,e1+,_sc_]; }
                ?hb[t,e] == ',' { et[c,e1+,_frozen_,a,_sc_,_out_]; }
                j=j1+;
            }
        }
        i=i1+;
    }
    rv;
}

##! Parse one index/slice suffix against base.
~eu c _base_ p _score_ {
    _out_:=vn[]; t:=c['t'];
    ?hb[t,p] != '[' {rv _out_;}
    q:=p1+;
    ##! omitted-start slice
    ?hb[t,q] == ':' {
        ew[c,_base_,nn,q1+,_score_,_out_];
        rv ic[_out_];
    }
    _first_:=ez[c,q]; n:=vl[_first_]; i:=0;
    wl ?i<n {
        a:=vg[_first_,i]; e:=a['p'];
        ?hb[t,e] == ']' { x:=['k':'index','a':_base_,'b':a['e']]; hl[_out_,x,e1+,_score_ a['s'] +]; }
        ?hb[t,e] == ':' { ew[c,_base_,a['e'],e1+,_score_ a['s'] +,_out_]; }
        i=i1+;
    }
    rv ic[_out_];
}

##! Finish a slice after first colon.
~ew c _base_ _begin_ p _score_ _out_ {
    t:=c['t'];
    ?hb[t,p] == ']' { x:=['k':'slice','a':_base_,'b':_begin_,'c':nn,'d':nn]; hl[_out_,x,p1+,_score_]; rv; }
    ?hb[t,p] == ':' { ex[c,_base_,_begin_,nn,p1+,_score_,_out_]; rv; }
    _vals_:=ez[c,p]; n:=vl[_vals_]; i:=0;
    wl ?i<n {
        q:=vg[_vals_,i]; e:=q['p']; _sc_:=_score_ q['s'] +;
        ?hb[t,e] == ']' { x:=['k':'slice','a':_base_,'b':_begin_,'c':q['e'],'d':nn]; hl[_out_,x,e1+,_sc_]; }
        ?hb[t,e] == ':' { ex[c,_base_,_begin_,q['e'],e1+,_sc_,_out_]; }
        i=i1+;
    }
    rv;
}
~ex c _base_ _begin_ _stop_ p _score_ _out_ {
    t:=c['t'];
    ?hb[t,p] == ']' { x:=['k':'slice','a':_base_,'b':_begin_,'c':_stop_,'d':nn]; hl[_out_,x,p1+,_score_]; rv; }
    _vals_:=ez[c,p]; n:=vl[_vals_]; i:=0;
    wl ?i<n {
        q:=vg[_vals_,i];
        ?hb[t,q['p']] == ']' { x:=['k':'slice','a':_base_,'b':_begin_,'c':_stop_,'d':q['e']]; hl[_out_,x,q['p']1+,_score_ q['s'] +]; }
        i=i1+;
    }
    rv;
}

##! Recursively collect one-or-more postfix [] chains.  Base itself is retained by caller.
~ey c _base_ p _score_ {
    _out_:=vn[]; t:=c['t']; _more_:=vn[]; _mn_:=0; j:=0; x:=nn; _cand_:=nn; _mname_:='';
    ?hb[t,p]=='['{
        d:=eu[c,_base_,p,_score_]; n:=vl[d]; i:=0;
        wl ?i<n {
            q:=vg[d,i]; vp[_out_,q];
            _more_=ey[c,q['e'],q['p'],q['s']]; _mn_=vl[_more_]; j=0;
            wl ?j<_mn_ {vp[_out_,vg[_more_,j]];j=j1+;}
            i=i1+;
        }
    }
    ?hb[t,p]=='.'{
        _mp_:=p1+;_hard_:=0;
        ?hd[t,_mp_]=='LOWER'{?hd[t,_mp_1+]=='LOWER'{?hb[t,_mp_2+]=='['{
            _hard_=1;_mname_:=hb[t,_mp_] hb[t,_mp_1+]+;_packs_:=el[c,_mp_2+,1];_pn_:=vl[_packs_];_pi_:=0;
            wl?_pi_<_pn_{_pc_:=vg[_packs_,_pi_];x=['k':'method','n':_mname_,'a':_pc_['a'],'r':_base_,'c':nn,'z':0,'u':0];_cand_=['e':x,'p':_pc_['p'],'s':_score_ _pc_['s']+];vp[_out_,_cand_];
                _more_=ey[c,x,_pc_['p'],_cand_['s']];_mn_=vl[_more_];j=0;wl?j<_mn_{vp[_out_,vg[_more_,j]];j=j1+;}_pi_=_pi_1+;}
        }}}
        ?!_hard_{_mk_:=hd[t,_mp_];_mok_:=0;?_mk_=='LOWER'{_mok_=1;}?_mk_=='EXT'{_mok_=1;}?_mok_{
            _mname_=hb[t,_mp_];x=['k':'member','n':_mname_,'a':_base_,'c':nn,'z':0];_cand_=['e':x,'p':_mp_1+,'s':_score_];vp[_out_,_cand_];
            _more_=ey[c,x,_mp_1+,_score_];_mn_=vl[_more_];j=0;wl?j<_mn_{vp[_out_,vg[_more_,j]];j=j1+;}
        }}
    }
    rv ic[_out_];
}

##! Reserved statement/control pairs are not inferred callables in expression position.
~ja n {
    ?n=='rv'{rv1;} ?n=='lb'{rv1;} ?n=='if'{rv1;} ?n=='ei'{rv1;} ?n=='ee'{rv1;}
    ?n=='fl'{rv1;} ?n=='wl'{rv1;} ?n=='bl'{rv1;} ?n=='cl'{rv1;} ?n=='tr'{rv1;}
    ?n=='ca'{rv1;} ?n=='fn'{rv1;} ?n=='er'{rv1;} ?n=='nn'{rv1;}
    rv0;
}

##! Atom candidates (including postfix [] chains).
##! Assignment-expression atoms.
~ka c p o {
    t:=c['t'];
    ##! Member := / ::= is value-producing, like indexed :=.  Parse only the
    ##! assignable member prefix here; ordinary member reads/calls stay in atom/postfix parsing.
    _mt_:=vn[];_mk_:=hd[t,p];_mo_:=0;
    ?hb[t,p]=='.'{
        _ms_:=0;_mp_:=p1+;?hb[t,_mp_]=='.'{_ms_=1;_mp_=_mp_1+;}
        _mnk_:=hd[t,_mp_];_mno_:=0;?_mnk_=='LOWER'{_mno_=1;}?_mnk_=='EXT'{_mno_=1;}
        ?_mno_{_me_:=['k':'member','n':hb[t,_mp_],'a':nn,'c':nn,'z':_ms_];hl[_mt_,_me_,_mp_1+,0];}
    }
    ?_mk_=='UPPER'{?hd[t,p1+]=='UPPER'{?hb[t,p2+]=='.'{
        _mp_:=p3+;_mnk_:=hd[t,_mp_];_mno_:=0;?_mnk_=='LOWER'{_mno_=1;}?_mnk_=='EXT'{_mno_=1;}
        ?_mno_{_mc_:=hb[t,p] hb[t,p1+]+;_me_:=['k':'member','n':hb[t,_mp_],'a':nn,'c':_mc_,'z':1];hl[_mt_,_me_,_mp_1+,0];}
    }}}
    _mbo_:=0;?_mk_=='LOWER'{_mbo_=1;}?_mk_=='EXT'{_mbo_=1;}
    ?_mbo_{?hb[t,p1+]=='.'{
        _mb_:=nn;?_mk_=='LOWER'{_mb_=hn['var',hb[t,p]];}ee{_mb_=hn['ext',hb[t,p]];}
        _mp_:=p2+;_mnk_:=hd[t,_mp_];_mno_:=0;?_mnk_=='LOWER'{_mno_=1;}?_mnk_=='EXT'{_mno_=1;}
