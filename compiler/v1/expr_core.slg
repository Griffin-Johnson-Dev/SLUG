            wl?j<_rn_{r:=vg[_rights_,j];_pen_:=jb[c,_rights_,r];x:=ht[_op_,l['e'],r['e']];hl[_out_,x,r['p'],l['s'] r['s'] + _pen_ +];j=j1+;}
        }
        ee{
