##! Append one atom candidate plus any postfix [] expansions.
~ki c q r {
    t:=c['t'];_pf_:=hb[t,q['p']];_hm_:=0;
    ?_pf_=='.'{_hp_:=q['p']1+;?hd[t,_hp_]=='LOWER'{?hd[t,_hp_1+]=='LOWER'{?hb[t,_hp_2+]=='['{_hm_=1;}}}}
