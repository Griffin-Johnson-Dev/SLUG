##! Minimum Boolean-separator crossing penalty for an expression candidate list.
~jb c a _cand_ {
    t:=c['t']; n:=vl[a]; _cut_:=2147483647$; i:=0;
    wl?i<n{q:=vg[a,i];x:=hb[t,q['p']];?x=='+'{?q['p']<_cut_{_cut_=q['p'];}}?x=='/'{?q['p']<_cut_{_cut_=q['p'];}}i=i1+;}
    ?_cut_<2147483647${?_cand_['p']>_cut_{rv 12$;}}
