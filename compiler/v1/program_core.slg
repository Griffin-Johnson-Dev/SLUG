##! SLUG v1 ambiguity-aware ordinary program/statement parser.
##! Reconstructed against the frozen v0.1.7.1 Python oracle.
>'expr_api.slg'
>'common_api.slg'
>'vector_api.slg'
>'signature_api.slg'
>'function_header.slg'

##! Roughly skip the deliberately small parameter-default subset used by the
##! declaration signature prepass. Returns p unchanged when the extent is unknown.


##! Rough function arity scan used before ordinary expression parsing. A variadic
##! capture gets a very large explicit-pack ceiling; dense inference remains disabled.


##! Layer all named-function arities over the frozen builtin signature table before
##! any expression candidates are requested. This enables recursion and forward calls.
~qm c {
    t:=c['t'];s:=c['s'];i:=0;n:='';r:=nn;_al_:=c['u'];_std_:=c['w'];_reg_:=c['r'];
    wl?yb[t,i]!='EOF'{
        ?ya[t,i]=='>'{?yb[t,i1+]=='STRING'{
            _pth_:=pb[ya[t,i1+]];_q_:=i2+;
            ?ya[t,_q_]==':'{_ar_:=pr[c,_q_1+];?_ar_!=nn{_hs_:=in[_pth_,_std_];?_hs_{_alias_:=_ar_['n'];_dup_:=in[_alias_,_reg_];?_dup_{er'duplicate module alias';}_al_[_alias_]:=_pth_;_emptyg_:=[:];_emptyc_:=[:];_desc_:=['s':1,'i':_pth_,'f':_std_[_pth_],'g':_emptyg_,'c':_emptyc_];_reg_[_alias_]:=_desc_;}}}
        }}
        j:=i;?ya[t,j]=='-'{x:=ya[t,j1+];?x=='~'{j=j1+;}?x=='~~'{j=j1+;}?x=='#'{j=j1+;}}
        h:=ya[t,j];
        ?h=='#'{r=qn[c,j];?r['o']{n=r['n'];_ct_:=c['c'];_ct_[n]:=['a':r['a'],'b':r['b'],'h':r['h']];i=r['p'];cl}}
        _fn_:=0;?h=='~'{_fn_=1;}?h=='~~'{_fn_=1;}
        ?_fn_{?yb[t,j1+]=='LOWER'{?yb[t,j2+]=='LOWER'{
            n=ya[t,j1+] ya[t,j2+]+;r=ql[c,j3+];_ar_:=r['a'];_br_:=r['b'];_dr_:=r['d'];s[n]:=['a':_ar_,'b':_br_,'d':_dr_];i=j3+;cl
        }}}
        i=i1+;
    }
    rv;
}

##! Precompute lexical active-module namespaces by token position. Namespace
##! selection is lexical and block-scoped, so parser ambiguity does not carry state.
~qx c {
    t:=c['t'];m:=[:];_stack_:=xc[];_depth_:=0;_cur_:=nn;_any_:=0;i:=0;
    wl?yb[t,i]!='EOF'{
        ?_cur_!=nn{k:=@s|i|;m[k]:=_cur_;}x:=ya[t,i];
        ?x=='\{'{xd[_stack_,_cur_];_depth_=_depth_1+;i=i1+;cl}
        ?x=='\}'{?_depth_>0{_depth_=_depth_1-;_cur_=xa[_stack_,_depth_];}i=i1+;cl}
        ?x=='<:.'{_cur_=nn;i=i1+;cl}
        ?x=='<:'{
            r:=pr[c,i1+];?r==nn{er'invalid module namespace selector';}
            a:=r['n'];_reg_:=c['r'];_has_:=in[a,_reg_];?!_has_{er'unknown module namespace';}
            _any_=1;_cur_=a;i=r['p'];cl
        }
        i=i1+;
    }
    c['n']=m;c['N']=_any_;rv;
}

##! Program context. User callable signatures are layered in by the declaration prepass.
~pa s {
    g:=ua[];
    c:=ze[s,g];
    qm[c];qx[c];
    rv c;
}

##! Decode the simple quoted strings used by import paths.
##! Full string escape semantics remain expression-level; import fixtures use plain paths.
~pb x {
    n:=ln[x];
    ?n<2{rv x;}
    z:=x[1:n1-];
    rv z;
}

##! Parse one legal module alias after an import colon. Returns ['n':name,'p':end] or nn.
~pr c p {
    t:=c['t'];k:=yb[t,p];
    ?k=='LOWER'{n:=ya[t,p];e:=p1+;z:=['n':n,'p':e];rv z;}
    ?k=='EXT'{n:=ya[t,p];e:=p1+;z:=['n':n,'p':e];rv z;}
    ?k=='UPPER'{e:=p1+;?yb[t,e]=='UPPER'{a:=ya[t,p];b:=ya[t,e];n:=a b +;e=p2+;z:=['n':n,'p':e];rv z;}}
    rv nn;
}

##! Parse one class header. p points at '#'. Interfaces are intentionally left to the
##! later interface layer; audited class inheritance + constructor params are preserved here.
~qn c p {
    t:=c['t'];?ya[t,p]!='#'{rv ['o':0,'p':p];}
    ?yb[t,p1+]!='UPPER'{rv ['o':0,'p':p];}?yb[t,p2+]!='UPPER'{rv ['o':0,'p':p];}
    n:=ya[t,p1+] ya[t,p2+]+;q:=p3+;h:=nn;
    ?ya[t,q]=='<'{?yb[t,q1+]=='UPPER'{?yb[t,q2+]=='UPPER'{h=ya[t,q1+] ya[t,q2+]+;q=q3+;}ee{rv ['o':0,'p':p];}}ee{rv ['o':0,'p':p];}}
    r:=ql[c,q];?r['o']==0{rv ['o':0,'p':p];}
    ##! Class constructor headers cannot use function-only return contracts or variadic captures.
    ?r['r']!=nn{rv ['o':0,'p':p];}?r['x']!=nn{rv ['o':0,'p':p];}
    rv ['o':1,'n':n,'a':r['a'],'b':r['b'],'v':r['v'],'p':r['p'],'h':h];
}

##! Fingerprint simple statement families; nn means not handled.
~qd x {
    k:=x['k'];a:=nn;
    ?k=='comment'{s:='K(' x['t'] +;s=s ')'+;rv s;}
    ?k=='import'{s:='P(' x['p'] +;s=s ','+;a=x['a'];?a==nn{s=s '_'+;}ee{s=s a+;}s=s ')'+;rv s;}
    ?k=='namespace'{s:='NS(';a=x['a'];?a==nn{s=s '_'+;}ee{s=s a+;}s=s ')'+;rv s;}
    ?k=='break'{rv'BR';}
    ?k=='continue'{rv'CT';}
    rv nn;
}
~qe x {
    k:=x['k'];
    ?k=='return'{s:='R' yg[x['v']]+;rv s;}
    ?k=='raise'{v:=x['v'];s:='H(';?v==nn{s=s '_'+;}ee{s=s yh[v]+;}s=s ')'+;rv s;}
    ?k=='try'{
        s:='TR(';s=s qb[x['b']]+;s=s ','+;n:=x['n'];?n==nn{s=s '_'+;}ee{s=s n+;}
        s=s ','+;v:=x['c'];?v==nn{s=s '_'+;}ee{s=s qb[v]+;}
        s=s ','+;v=x['f'];?v==nn{s=s '_'+;}ee{s=s qb[v]+;}s=s ')'+;rv s;
    }
    ?k=='while'{s:='WL(';s=s yh[x['c']]+;s=s ','+;s=s qb[x['b']]+;s=s ')'+;rv s;}
    ?k=='for'{
        s:='FL(';s=s x['y']+;s=s ','+;n:=x['n'];?n==nn{s=s '_'+;}ee{s=s n+;}
        s=s ','+;v:=x['q'];?v==nn{s=s '_'+;}ee{s=s yh[v]+;}
        s=s ','+;v=x['a'];?v==nn{s=s '_'+;}ee{s=s yh[v]+;}
        s=s ','+;v=x['z'];?v==nn{s=s '_'+;}ee{s=s yh[v]+;}
        s=s ','+;v=x['d'];?v==nn{s=s '_'+;}ee{s=s yh[v]+;}
        s=s ','+;s=s qb[x['b']]+;s=s ')'+;rv s;
    }
    ?k=='if'{
        s:='IF(';s=s yh[x['c']]+;s=s ','+;s=s qb[x['b']]+;s=s ',['+;e:=x['e'];n:=xb[e];i:=0;
        wl?i<n{?i>0{s=s ','+;}r:=xa[e,i];s=s '('+;s=s yh[r['c']]+;s=s ','+;s=s qb[r['b']]+;s=s ')'+;i=i1+;}
        s=s '],'+;b:=x['x'];?b==nn{s=s '_'+;}ee{s=s qb[b]+;}s=s ')'+;rv s;
    }
    rv nn;
}
~qf x {
    k:=x['k'];s:='';a:=xc[];n:=0;i:=0;y:=nn;t:=nn;d:=nn;r:=nn;v:=nn;
    ?k=='assign'{s:='W(' yg[x['a']]+;s=s ','+;s=s yi[x['y']]+;s=s ','+;s=s yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='export'{s:='EX(' x['n']+;s=s ','+;s=s x['o']+;s=s ','+;s=s yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='module-var-assign'{s:='MW(' x['u']+;s=s ','+;s=s x['n']+;s=s ','+;s=s yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='mutate'{s:='U(' x['o']+;s=s ','+;s=s yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='expr'{s:='E(' yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='set-index'{s:='WI(';s=s yh[x['a']]+;s=s ','+;s=s yh[x['v']]+;s=s ')'+;rv s;}
    ?k=='set-member-stmt'{s:='WM(';s=s yh[x['a']]+;s=s ','+;s=s yh[x['v']]+;s=s ','+;?x['d']{s=s 'D'+;}ee{s=s 'U'+;}s=s ','+;?x['i']{s=s 'I'+;}ee{s=s 'M'+;}s=s ','+;?x['p']{s=s 'P'+;}ee{s=s 'U'+;}s=s ')'+;rv s;}
    ?k=='super-init'{s:='SU';s=s yg[x['a']]+;rv s;}
    ?k=='destructor'{s:='DT(';s=s qb[x['v']]+;s=s ')'+;rv s;}
    ?k=='class'{
        s='CL(';s=s x['n']+;s=s ','+;?x['p']{s=s 'P'+;}ee{s=s 'U'+;}s=s ',['+;
        a=x['a'];n=xb[a];i=0;wl?i<n{?i>0{s=s ','+;}y=xa[a,i];s=s 'P('+;s=s y['n']+;s=s ':'+;t=y['t'];?t==nn{s=s '_'+;}ee{s=s t+;}s=s ':'+;d=y['d'];?d==nn{s=s '_'+;}ee{s=s yh[d]+;}s=s ')'+;i=i1+;}
        s=s '],'+;s=s qb[x['v']]+;s=s ')'+;rv s;
    }
    ?k=='function'{
        s='FN(';s=s x['n']+;s=s ','+;?x['z']{s=s 'S'+;}ee{s=s 'I'+;}s=s ','+;
        ?x['p']{s=s 'P'+;}ee{s=s 'U'+;}s=s ','+;r=x['r'];
        ?r==nn{s=s '_'+;}ee{s=s '['+;n=xb[r];i=0;wl?i<n{?i>0{s=s ','+;}s=s xa[r,i]+;i=i1+;}s=s ']'+;}
        s=s ',['+;a=x['a'];n=xb[a];i=0;wl?i<n{?i>0{s=s ','+;}y=xa[a,i];s=s 'P('+;s=s y['n']+;s=s ':'+;
            t=y['t'];?t==nn{s=s '_'+;}ee{s=s t+;}s=s ':'+;d=y['d'];?d==nn{s=s '_'+;}ee{s=s yh[d]+;}s=s ')'+;i=i1+;}
        s=s '],'+;v=x['x'];?v==nn{s=s '_'+;}ee{s=s v+;}s=s ','+;s=s qb[x['v']]+;s=s ')'+;rv s;
    }
    rv nn;
}

##! Statement semantic fingerprint.
~qa x {
    s:=qd[x];?s!=nn{rv s;}
    s=qe[x];?s!=nn{rv s;}
    s=qf[x];?s!=nn{rv s;}
    er'unknown v1 statement fingerprint kind';
}

##! Fingerprint a statement vector.
~qb a {
    s:='[';n:=xb[a];i:=0;
    wl?i<n{?i>0{s=s ','+;}s=s qa[xa[a,i]]+;i=i1+;}
    s=s ']'+;rv s;
}

##! Dedupe statement candidates by (end,semantic fingerprint), keeping cheapest score.
~qc a {
    o:=xc[];m:=[:];n:=xb[a];i:=0;
    wl?i<n{
        c:=xa[a,i];f:=qa[c['e']];k:=@s|c['p']|;k=k ':'+;k=k f+;
        _qchas_:=in[k,m];?!_qchas_{m[k]:=xb[o];xd[o,c];}
        ee{j:=m[k];d:=xa[o,j];?c['s']<d['s']{xe[o,j,c];}}
        i=i1+;
    }
    rv o;
}

##! comments/imports
~pd c p o {
    t:=c['t'];
    ?yb[t,p]=='COMMENT'{z:=['k':'comment','t':ya[t,p],'p':xa[t,p]['p']];yd[o,z,p1+,0];rv;}
    ?ya[t,p]=='>'{?yb[t,p1+]=='STRING'{q:=p2+;a:=nn;?ya[t,q]==':'{r:=pr[c,q1+];?r!=nn{a=r['n'];q=r['p'];}}z:=['k':'import','p':pb[ya[t,p1+]],'a':a];yd[o,z,q,0];}}
    ?ya[t,p]=='<:.'{z:=['k':'namespace','a':nn];yd[o,z,p1+,0];rv;}
    ?ya[t,p]=='<:'{r:=pr[c,p1+];?r!=nn{a:=r['n'];_reg_:=c['r'];_has_:=in[a,_reg_];?_has_{z:=['k':'namespace','a':a];yd[o,z,r['p'],0];rv;}}}
    ?ya[t,p]=='+'{?ya[t,p1+]==':'{
        r:=zb[c,p2+];?r!=nn{_ta_:=r['a'];?_ta_!=nn{?xb[_ta_]==1{_op_:=ya[t,r['p']];_ok_:=0;?_op_==':='{_ok_=1;}?_op_=='::='{_ok_=1;}?_ok_{
            _rhs_:=zc[c,r['p']1+];_rn_:=xb[_rhs_];_ri_:=0;wl?_ri_<_rn_{_rc_:=xa[_rhs_,_ri_];_target_:=xa[_ta_,0];_types_:=r['y'];_tc_:=xa[_types_,0];z:=['k':'export','n':_target_['n'],'t':_tc_,'o':_op_,'v':_rc_['e']];yd[o,z,_rc_['p'],_rc_['s']];_ri_=_ri_1+;}rv;
        }}}}
    }}
    _ci_:=p;_cpr_:=0;?ya[t,_ci_]=='-'{?ya[t,_ci_1+]=='#'{_cpr_=1;_ci_=_ci_1+;}}
    ?ya[t,_ci_]=='#'{
        _ch_:=ql[c,_ci_];?_ch_['o']{_cb_:=_ch_['p'];?ya[t,_cb_]=='\{'{?ya[t,_cb_1+]=='\}'{
            z:=['k':'class','n':_ch_['n'],'a':_ch_['v'],'v':xc[],'p':_cpr_];yd[o,z,_cb_2+,0];rv;
        }}}
    }
    i:=p;_priv_:=0;_stat_:=0;h:='';
    ?ya[t,i]=='-'{h=ya[t,i1+];_good_:=0;?h=='~'{_good_=1;}?h=='~~'{_good_=1;}?!_good_{rv;}_priv_=1;i=i1+;}
    h=ya[t,i];?h=='~~'{_stat_=1;}?h!='~'{?h!='~~'{rv;}}?yb[t,i1+]!='LOWER'{rv;}?yb[t,i2+]!='LOWER'{rv;}
    _name_:=ya[t,i1+] ya[t,i2+]+;u:=ql[c,i3+];_pdok_:=u['o'];?!_pdok_{rv;}i=u['p'];?ya[t,i]!='\{'{rv;}
    g:=po[c,i1+,'\}'];_gn_:=xb[g];?_gn_<=0{rv;}_sc_:=2147483647$;v:=nn;f:='';_ties_:=0;_close_:=0;j:=0;
    wl?j<_gn_{q:=xa[g,j];w:=q['s'];?w<_sc_{_sc_=w;v=q['v'];f=qb[v];_ties_=1;_close_=q['p'];}ee{?w==_sc_{e:=qb[q['v']];?e!=f{_ties_=_ties_1+;}}}j=j1+;}
    ?v==nn{rv;}?_ties_>1{rv;}z:=['k':'function','n':_name_,'a':u['v'],'v':v,'z':_stat_,'p':_priv_,'r':u['r'],'x':u['x']];yd[o,z,_close_1+,0];rv;
}

##! Full class declaration candidates, including one optional two-letter parent.
~qo c p o {
    t:=c['t'];q:=p;v:=0;
    ?ya[t,q]=='-'{?ya[t,q1+]=='#'{v=1;q=q1+;}ee{rv;}}
    ?ya[t,q]!='#'{rv;}
    h:=qn[c,q];?h['o']==0{rv;}b:=h['p'];?ya[t,b]!='\{'{rv;}
    g:=po[c,b1+,'\}'];n:=xb[g];i:=0;
    wl?i<n{x:=xa[g,i];z:=['k':'class','n':h['n'],'a':h['v'],'v':x['v'],'p':v,'h':h['h']];yd[o,z,x['p']1+,x['s']];i=i1+;}
    rv;
}

##! Destructor declaration.
~qp c p o {
    t:=c['t'];?ya[t,p]!='~-'{rv;}?ya[t,p1+]!='\{'{rv;}
    g:=po[c,p2+,'\}'];n:=xb[g];i:=0;wl?i<n{x:=xa[g,i];z:=['k':'destructor','v':x['v']];yd[o,z,x['p']1+,x['s']];i=i1+;}rv;
}

##! Private current instance/static field declaration.
~qq c p o {
    t:=c['t'];?ya[t,p]!='-'{rv;}?ya[t,p1+]!='.'{rv;}
    q:=p2+;z:=0;?ya[t,q]=='.'{z=1;q=q1+;}k:=yb[t,q];u:=0;?k=='LOWER'{u=1;}?k=='EXT'{u=1;}?u==0{rv;}
    e:=q1+;w:=ya[t,e];d:=0;i:=0;?w==':='{d=1;}?w=='::='{d=1;i=1;}?d==0{rv;}
    a:=zc[c,e1+];n:=xb[a];j:=0;wl?j<n{r:=xa[a,j];m:=['k':'member','n':ya[t,q],'a':nn,'c':nn,'z':z];x:=['k':'set-member-stmt','a':m,'v':r['e'],'d':1,'i':i,'p':1];yd[o,x,r['p'],r['s']];j=j1+;}rv;
}

##! Explicit parent-constructor invocation.
~qr c p o {
    t:=c['t'];?ya[t,p]!='^^'{rv;}?ya[t,p1+]!='['{rv;}
    a:=zh[c,p1+];n:=xb[a];i:=0;
    wl?i<n{r:=xa[a,i];z:= ['k':'super-init','a':r['a']];yd[o,z,r['p'],r['s']];i=i1+;}rv;
}

##! break / continue + block control.  The internal qi tail mode keeps the
##! public callable surface unchanged while parsing recursive ei/ee chains.
~qg c p o {
    t:=c['t'];n:=za[c,p];a:=xc[];_an_:=0;i:=0;d:=nn;b:=0;g:=xc[];_gn_:=0;j:=0;h:=nn;u:=xc[];_un_:=0;k:=0;r:=nn;z:=nn;
    ?n=='bl'{z:=ye['break'];yd[o,z,p2+,0];}
    ?n=='cl'{z:=ye['continue'];yd[o,z,p2+,0];}

    _if_:=0;q:=p;
    ?n=='if'{_if_=1;q=p2+;}?ya[t,p]=='?'{_if_=1;q=p;}
    ?ya[t,q]!='?'{_if_=0;}
    ?_if_{
        a=zc[c,q];_an_=xb[a];i=0;
        wl?i<_an_{
            d=xa[a,i];b=d['p'];?ya[t,b]=='\{'{
                g=po[c,b1+,'\}'];_gn_=xb[g];j=0;
                wl?j<_gn_{
                    h=xa[g,j];u=qi[c,h['p']1+,'T'];_un_=xb[u];k=0;
                    wl?k<_un_{
                        r=xa[u,k];z=['k':'if','c':d['e'],'b':h['v'],'e':r['e'],'x':r['x']];
                        yd[o,z,r['p'],d['s'] h['s'] + r['s'] +];k=k1+;
                    }
                    j=j1+;
                }
            }i=i1+;
        }
    }

    ?n=='wl'{
        q=p2+;?ya[t,q]=='?'{a=zc[c,q];_an_=xb[a];i=0;
        wl?i<_an_{d=xa[a,i];b=d['p'];?ya[t,b]=='\{'{
            g:=po[c,b1+,'\}'];_gn_:=xb[g];j:=0;
            wl?j<_gn_{h=xa[g,j];z:=['k':'while','c':d['e'],'b':h['v']];yd[o,z,h['p']1+,d['s'] h['s'] +];j=j1+;}
        }i=i1+;}
        }
    }
    rv;
}

##! Recursive return-value candidate collector, depth-capped like the oracle.
~ps c p v s d o {
    t:=c['t'];
    ?xb[v]>0{z:=['k':'return','v':v];yd[o,z,p,s];}
    x:=ya[t,p];?x==';'{rv;}?x=='\}'{rv;}?yb[t,p]=='EOF'{rv;}
    ?za[c,p]=='nn'{_nul_:=['k':'lit','t':'null','r':'nn'];w:=yc[v,_nul_];ps[c,p2+,w,s,d1+,o];rv;}
    a:=zc[c,p];n:=xb[a];i:=0;
    wl?i<n{q:=xa[a,i];?q['p']>p{w:=yc[v,q['e']];ps[c,q['p'],w,s q['s']+,d1+,o];}i=i1+;}
    rv;
}

##! return
~pg c p o {
    ?za[c,p]!='rv'{rv;}
    t:=c['t'];q:=p2+;x:=ya[t,q];
    ?x==';'{v:=xc[];z:=['k':'return','v':v];yd[o,z,q,0];rv;}
    ?x=='\}'{v:=xc[];z:=['k':'return','v':v];yd[o,z,q,0];rv;}
    ?yb[t,q]=='EOF'{v:=xc[];z:=['k':'return','v':v];yd[o,z,q,0];rv;}
    v:=xc[];ps[c,q,v,0,0,o];rv;
}

##! raise + try/catch/finally exception statements.
~ph c p o {
    _pair_:=za[c,p];j:=0;h:=nn;k:=0;z:=nn;
    ?_pair_=='er'{
        t:=c['t'];_ep_:=p2+;_ex_:=ya[t,_ep_];
        ?_ex_==';'{z:=['k':'raise','v':nn];yd[o,z,_ep_,0];rv;}
        ?_ex_=='\}'{z:=['k':'raise','v':nn];yd[o,z,_ep_,0];rv;}
        ?yb[t,_ep_]=='EOF'{z:=['k':'raise','v':nn];yd[o,z,_ep_,0];rv;}
        a:=zc[c,_ep_];n:=xb[a];i:=0;
        wl?i<n{q:=xa[a,i];z=['k':'raise','v':q['e']];yd[o,z,q['p'],q['s']];i=i1+;}rv;
    }
    ?_pair_!='tr'{rv;}
    t:=c['t'];?ya[t,p2+]!='\{'{rv;}
