~rd t e u h {
    g:=ua[];_en_:=xb[e];_ei_:=0;q:='';r:=nn;
    wl?_ei_<_en_{r=xa[e,_ei_];q=r['n'];_sg_:=['a':r['a'],'b':r['b'],'d':r['d']];g[q]:=_sg_;_ei_=_ei_1+;}
    c:=zg[t,g];c['r']=u;c['c']=h;qm[c];qx[c];a:=po[c,0,nn];n:=xb[a];?n<=0{er'v1 program parser: incomplete program';}
    b:=2147483647$;v:=nn;f:='';_ties_:=0;i:=0;
    wl?i<n{q=xa[a,i];?q['s']<b{b=q['s'];v=q['v'];f=qb[v];_ties_=1;}ee{?q['s']==b{z:=qb[q['v']];?z!=f{_ties_=_ties_1+;}}}i=i1+;}
    ?v==nn{er'v1 program parser: incomplete program';}?_ties_>1{er'v1 program parser: ambiguous cheapest program';}
    _used_:=[:];rb[c,v,0,xb[t],_used_];rv v;
}

##! Choose unique cheapest complete program and return its statement vector.
~pp s {
    c:=pa[s];a:=po[c,0,nn];n:=xb[a];?n<=0{er'v1 program parser: incomplete program';}
    b:=2147483647$;v:=nn;f:='';_ties_:=0;i:=0;
    wl?i<n{q:=xa[a,i];?q['s']<b{b=q['s'];v=q['v'];f=qb[v];_ties_=1;}ee{?q['s']==b{z:=qb[q['v']];?z!=f{_ties_=_ties_1+;}}}i=i1+;}
    ?v==nn{er'v1 program parser: incomplete program';}?_ties_>1{er'v1 program parser: ambiguous cheapest program';}
    rv v;
}

~pt s {g:=ua[];c:=ze[s,g];x:=c['t'];rv x;}

~pu t e {
    g:=ua[];_en_:=xb[e];_ei_:=0;q:='';r:=nn;
    wl?_ei_<_en_{r=xa[e,_ei_];q=r['n'];_sg_:=['a':r['a'],'b':r['b'],'d':r['d']];g[q]:=_sg_;_ei_=_ei_1+;}
    c:=zg[t,g];_emptyreg_:=[:];c['r']=_emptyreg_;qm[c];qx[c];a:=po[c,0,nn];n:=xb[a];?n<=0{er'v1 program parser: incomplete program';}
    b:=2147483647$;v:=nn;f:='';_ties_:=0;i:=0;
    wl?i<n{q=xa[a,i];?q['s']<b{b=q['s'];v=q['v'];f=qb[v];_ties_=1;}ee{?q['s']==b{z:=qb[q['v']];?z!=f{_ties_=_ties_1+;}}}i=i1+;}
    ?v==nn{er'v1 program parser: incomplete program';}?_ties_>1{er'v1 program parser: ambiguous cheapest program';}
    rv v;
}

##! Parse pre-tokenized source with direct callable signatures, user-module
##! alias metadata, and direct imported class signatures supplied by Stage 2.
~qy t e u h {
    g:=ua[];_en_:=xb[e];_ei_:=0;q:='';r:=nn;
    wl?_ei_<_en_{r=xa[e,_ei_];q=r['n'];_sg_:=['a':r['a'],'b':r['b'],'d':r['d']];g[q]:=_sg_;_ei_=_ei_1+;}
    c:=zg[t,g];c['r']=u;c['c']=h;qm[c];qx[c];a:=po[c,0,nn];n:=xb[a];?n<=0{er'v1 program parser: incomplete program';}
    b:=2147483647$;v:=nn;f:='';_ties_:=0;i:=0;
    wl?i<n{q=xa[a,i];?q['s']<b{b=q['s'];v=q['v'];f=qb[v];_ties_=1;}ee{?q['s']==b{z:=qb[q['v']];?z!=f{_ties_=_ties_1+;}}}i=i1+;}
    ?v==nn{er'v1 program parser: incomplete program';}?_ties_>1{er'v1 program parser: ambiguous cheapest program';}
    rv v;
}

~pv t {
    o:=xc[];i:=0;d:=0;
    wl?yb[t,i]!='EOF'{
        x:=ya[t,i];
        ?x=='\{'{d=d1+;i=i1+;cl}
        ?x=='\}'{?d>0{d=d1-;}i=i1+;cl}
        ?d==0{?x=='>'{?yb[t,i1+]=='STRING'{
            p:=pb[ya[t,i1+]];q:=i2+;a:=nn;
            ?ya[t,q]==':'{
                k:=yb[t,q1+];
                ?k=='LOWER'{a=ya[t,q1+];q=q2+;}
                ?k=='EXT'{a=ya[t,q1+];q=q2+;}
                ?k=='UPPER'{?yb[t,q2+]=='UPPER'{a=ya[t,q1+] ya[t,q2+]+;q=q3+;}}
            }
            r:=['p':p,'a':a];xd[o,r];i=q;cl
        }}}
        i=i1+;
    }
    rv o;
}

##! Convenience semantic fingerprint.
~pq s {v:=pp[s];rv qb[v];}
