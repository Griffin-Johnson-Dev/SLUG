    ?_ctl_{_xp_:=x2+;?ya[t,_xp_]!='?'{z:=xa[t,_xp_];_tx_:=z['t'];_ec_:=z['c'] ln[_tx_]+;?_tx_==''{_ec_=z['c']1+;}rv ['found':1,'line':z['l'],'column':z['c'],'end_line':z['l'],'end_column':_ec_,'token':_tx_];}}
    ?_pair_=='tr'{_xp_:=x2+;?ya[t,_xp_]!='\{'{z:=xa[t,_xp_];_tx_:=z['t'];_ec_:=z['c'] ln[_tx_]+;?_tx_==''{_ec_=z['c']1+;}rv ['found':1,'line':z['l'],'column':z['c'],'end_line':z['l'],'end_column':_ec_,'token':_tx_];}}
